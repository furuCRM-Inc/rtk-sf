{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m rtk_sf.hooks.bash_guard"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m rtk_sf.hooks.ocr_intercept"
          }
        ]
      }
    ]
  }
}
